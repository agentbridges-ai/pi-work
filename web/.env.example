# Browser-build variables only. Never add model or MCP credentials under a
# VITE_ name: Vite values are delivered to the browser bundle.
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# OnlyOffice browser runtime and generated font assets.
# The default local development paths point at sibling onlyoffice-browser outputs
# when they exist; set these explicitly for other machines or deployments.
# PIWORK_ONLYOFFICE_BROWSER_PUBLIC_DIR=/Users/xy/Documents/onlyoffice-browser/dist
# ONLYOFFICE_BROWSER_FONT_ASSETS_DIR=/Users/xy/Documents/onlyoffice-browser/.onlyoffice-font-assets
# Remote IP and FRP deployments must provide an independent, browser-reachable
# Office host. Wildcard DNS/TLS should route every generated subdomain.
# VITE_PIWORK_ONLYOFFICE_HOST_URL_TEMPLATE=https://{sessionId}.office-host.workspace.example.com/office-host.html
