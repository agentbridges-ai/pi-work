{
  "name": "piwork",
  "version": "0.95.0",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "description": "Pi-native agent workbench",
  "license": "MIT",
  "author": "The Vibe Company",
  "bin": {
    "piwork": "./bin/cli.ts",
    "user-space": "./bin/user-space.ts",
    "onlyoffice": "./bin/onlyoffice.ts"
  },
  "files": [
    "bin/",
    "server/",
    "shared/",
    "dist/"
  ],
  "engines": {
    "bun": "1.3.9",
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-agent",
    "pi-rpc",
    "ai",
    "agent",
    "digital-agent",
    "workspace",
    "web-ui"
  ],
  "scripts": {
    "build": "node node_modules/vite/bin/vite.js build && bun scripts/check-ui-bundle-budgets.mjs",
    "check:ui-bundles": "bun scripts/check-ui-bundle-budgets.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "lint:fix": "node node_modules/eslint/bin/eslint.js . --fix",
    "format": "node node_modules/prettier/bin/prettier.cjs --config ../prettier.config.mjs --ignore-path ../.prettierignore --write ../web ../scripts ../docs ../README.md ../Makefile ../package.json ../.github ../.codex ../.env.example ../.dockerignore ../.editorconfig ../.gitattributes ../.prettierignore ../prettier.config.mjs --ignore-unknown",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --config ../prettier.config.mjs --ignore-path ../.prettierignore --check ../web ../scripts ../docs ../README.md ../Makefile ../package.json ../.github ../.codex ../.env.example ../.dockerignore ../.editorconfig ../.gitattributes ../.prettierignore ../prettier.config.mjs --ignore-unknown",
    "deadcode:check": "node node_modules/typescript/bin/tsc --project tsconfig.deadcode.json",
    "dry:check": "node node_modules/jscpd/bin/jscpd src server --min-lines 20 --threshold 1.5 --reporters console --ignore \"**/*.test.ts,**/*.test.tsx,**/*.spec.ts,**/*.spec.tsx\"",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "bun scripts/run-better-auth-e2e.ts",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:a11y": "node node_modules/vitest/vitest.mjs run --testNamePattern='axe accessibility|accessible names|aria-expanded'",
    "test:perf:user-space": "RUN_USER_SPACE_PERF=1 node node_modules/vitest/vitest.mjs run src/user-space.test.ts src/components/preview-resource-registry.test.ts",
    "perf:user-space:browser": "bun scripts/user-space-cdp-perf.mjs"
  },
  "dependencies": {
    "@agentbridges-ai/onlyoffice-browser": "0.3.34",
    "@anthropic-ai/sandbox-runtime": "0.0.65",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@heroui/react": "^3.1.0",
    "@heroui/styles": "^3.1.0",
    "@iconify/react": "6.0.2",
    "@lezer/highlight": "^1.2.3",
    "@lobehub/ui": "^5.21.0",
    "@milkdown/crepe": "7.21.2",
    "@milkdown/kit": "7.21.2",
    "@radix-ui/react-context-menu": "2.3.2",
    "@tanstack/react-virtual": "^3.14.2",
    "@uiw/react-codemirror": "^4.25.10",
    "@wterm/dom": "0.3.0",
    "@wterm/react": "0.3.0",
    "axe-core": "^4.11.1",
    "better-auth": "1.6.20",
    "croner": "^10.0.1",
    "diff": "^8.0.3",
    "fflate": "0.8.3",
    "hono": "^4.12.30",
    "just-bash": "^3.0.1",
    "konva": "^10.3.0",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.5",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react-konva": "^19.2.5",
    "react-konva-utils": "^2.0.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "rehype-slug": "^6.0.0",
    "typebox": "1.1.38",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.2.5",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jscpd": "^4.0.8",
    "jsdom": "26.1.0",
    "prettier": "3.9.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "^6.3.0",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0",
    "zustand": "^5.0.0"
  },
  "overrides": {
    "dompurify": "3.4.12"
  }
}
