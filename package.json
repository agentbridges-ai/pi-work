{
  "name": "piwork-monorepo",
  "version": "0.95.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "description": "Pi-native agent workbench",
  "workspaces": [
    "web",
    "landing-page"
  ],
  "scripts": {
    "dev": "make dev",
    "build": "make build",
    "check": "make check",
    "format": "make format",
    "format:check": "make format-check",
    "lint": "make lint",
    "test": "make test",
    "typecheck": "make typecheck",
    "landing:dev": "cd landing-page && bun run dev",
    "landing:build": "cd landing-page && bun run build",
    "landing:lint": "cd landing-page && bun run lint",
    "prepare": "husky"
  },
  "author": "The Vibe Company",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {},
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
