# Piwork local environment reference
#
# Copy only the variables you need into .env. Do not commit real secrets.
# The local runtime stores all user/session state under data/ by default.

# ---------------------------------------------------------------------------
# Local server
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3457
VITE_PORT=3458
PIWORK_SERVE_FRONTEND=0
PIWORK_DATA_ROOT=./data
# Single-writer and maintenance locks default to ~/.piwork/runner.lock and
# .runtime/maintenance-backup.lock. Override both only as a coordinated pair.
PIWORK_RUNNER_LOCK_PATH=
PIWORK_MAINTENANCE_LOCK_DIR=

# ---------------------------------------------------------------------------
# Better Auth + Postgres
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://piwork:piwork@127.0.0.1:5432/piwork
# Required for `make dev` to auto-start a local Postgres after a failed
# connection check. Paths are explicit; there is no PGDATA or Homebrew fallback.
PIWORK_POSTGRES_DATA_DIR=
PIWORK_PG_CTL_BIN=
# Required only by `make test-e2e`. The runner refuses DATABASE_URL and
# truncates this dedicated database before and after every E2E run.
PIWORK_E2E_DATABASE_URL=postgres://piwork:piwork@127.0.0.1:5432/piwork_e2e
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# In production this is the exact browser Origin trusted by Better Auth,
# Cookie API mutations and browser WebSocket handshakes.
BETTER_AUTH_URL=http://127.0.0.1:3457

# ---------------------------------------------------------------------------
# Apps publishing (disabled unless explicitly enabled)
# ---------------------------------------------------------------------------
# Apps always deploy to a real Cloudflare account. Temporary previews and
# OAuth BYOC are independently opt-in and fail closed by default. There is no
# product-local Cloudflare runtime, platform account, or static API token.
PIWORK_APPS_TEMPORARY_ENABLED=false
PIWORK_APPS_BYOC_ENABLED=false
# AES-256-GCM envelope key: `openssl rand -base64 32`. This and the OAuth
# client secret are server-only and must never enter Agent/App environments.
PIWORK_APPS_CLOUDFLARE_CREDENTIAL_KEY=
PIWORK_APPS_CLOUDFLARE_OAUTH_CLIENT_ID=
PIWORK_APPS_CLOUDFLARE_OAUTH_CLIENT_SECRET=
PIWORK_APPS_CLOUDFLARE_OAUTH_REDIRECT_URI=
# Versioned JSON object generated when provisioning the OAuth client from
# Cloudflare GET /oauth/scopes. It contains version=1, the exact source URL,
# generatedAt, a [{"name","id"}] scopes array, and a sha256:... hash.
# Runtime verifies it again with the first exchanged user token and revokes on
# any name/id drift. It is configuration, not a bearer token.
PIWORK_APPS_CLOUDFLARE_OAUTH_SCOPE_CATALOG=
# Optional non-loopback abuse challenge. The site key is browser-visible; the
# secret is server-only. In-process admission limits remain enforced as well.
PIWORK_APPS_TURNSTILE_ENABLED=false
PIWORK_APPS_TURNSTILE_SITE_KEY=
PIWORK_APPS_TURNSTILE_SECRET_KEY=
PIWORK_APPS_TEMPORARY_MAX_PER_HOUR=3
PIWORK_APPS_TEMPORARY_MAX_PER_DAY=10
PIWORK_APPS_TEMPORARY_MAX_ACTIVE_PER_APP=1
PIWORK_APPS_TEMPORARY_MAX_POW_CONCURRENCY=2
# Development-only sanitised provider-event fixture replay. It never starts a
# Worker and is ignored when NODE_ENV=production.
PIWORK_APPS_LAB_ENABLED=false
# Emergency control for new deploy/rollback work.
PIWORK_APPS_KILL_SWITCH=false

# ---------------------------------------------------------------------------
# Native Pi runtime
# ---------------------------------------------------------------------------
# `local` is the in-process development compatibility mode. Compose uses the
# Runtime service and keeps this control channel on a private Unix socket.
PIWORK_RUNTIME_MODE=local
PIWORK_RUNTIME_SOCKET=/run/piwork-runtime/runtime.sock
PIWORK_RUNTIME_CONTROL_KEY_FILE=/run/secrets/piwork-runtime-control
PIWORK_RUNTIME_DEPLOYMENT_MODE=compose-nested
PIWORK_RUNTIME_SECURITY_GATE=verified
PIWORK_RUNTIME_SECURITY_MARKER=/etc/piwork/runtime-security.marker

# Runtime packages are exact direct dependencies:
# @earendil-works/pi-coding-agent@0.82.1
# @modelcontextprotocol/sdk@1.29.0
# Node.js must be >=22.19.0. Pi is always launched through native rpc-entry.
#
# During local development, provider credentials may be stored in the ignored
# root .env file. Keep that file mode 600 and never commit it. The launcher
# removes the credential from the API/Agent environment and delivers it to the
# trusted extension over a server-owned one-use Unix socket capability. Never
# put credentials in argv, logs, recordings, Pi JSONL, or session files.
PIWORK_PI_PROVIDER_API_KEY=
PIWORK_PI_PROVIDER_NAME=
PIWORK_PI_PROVIDER_BASE_URL=
PIWORK_PI_PROVIDER_API=
PIWORK_PI_PROVIDER_API_KEY_HEADER=
PIWORK_PI_PROVIDER_MODELS=

# Session runtime sandbox. `make install` installs the pinned local package:
# @anthropic-ai/sandbox-runtime@0.0.65
# Enforced session launch currently requires Linux: pinned SRT uses a PID namespace
# there. macOS/Windows fail closed before spawning because descendant containment
# cannot be proven. Launch also fails when the exact package or argv canary is unavailable.
PIWORK_SESSION_SANDBOX=srt
PIWORK_REQUIRE_SESSION_SANDBOX=1
# Comma/space-separated egress ceiling. When empty, only endpoints from
# server-injected providers are admitted by default; Agent policy may narrow
# but never widen them. Add managed MCP domains explicitly when needed.
PIWORK_SRT_ALLOWED_DOMAINS=
# Comma/space-separated provider/model globs. Effective models are also
# restricted by Agent policy, injectable credentials, and network policy.
PIWORK_PI_MODEL_ALLOWLIST=*/*

# ---------------------------------------------------------------------------
# Session lifecycle, user-space transfer, and recordings
# ---------------------------------------------------------------------------
PIWORK_RECONNECT_GRACE_MS=30000
PIWORK_SESSION_ACTIVATE_TIMEOUT_MS=45000
PIWORK_SESSION_ACTIVATE_PROBE_TIMEOUT_MS=1500
PIWORK_INIT_SCRIPT_TIMEOUT=120000
PIWORK_IDLE_KILL_MINUTES=30
PIWORK_DISCONNECT_DEBOUNCE_MS=15000
PIWORK_BOOTSTRAP_SESSION_LIMIT=100
# Per-Better-Auth-user admission limits shared across tenant runtimes.
PIWORK_MAX_CONCURRENT_SESSIONS=4
PIWORK_MAX_MANAGED_PROCESSES=8
PIWORK_USER_DISK_QUOTA_BYTES=5368709120
PIWORK_USER_DISK_LAUNCH_HEADROOM_BYTES=268435456
PIWORK_USER_DISK_MONITOR_INTERVAL_MS=30000
PIWORK_USER_SPACE_TIMEOUT_MS=30000
PIWORK_USER_SPACE_TRANSFER_TIMEOUT_MS=120000
PIWORK_USER_SPACE_MAX_TRANSFER_BYTES=104857600

# Development records by default. Production stays off unless the user explicitly
# opts in with PIWORK_RECORD=1.
PIWORK_RECORD=1
PIWORK_RECORDINGS_MAX_LINES=1000000
PIWORK_RECORDINGS_RETENTION_DAYS=7
PIWORK_RECORDINGS_MAX_SESSION_BYTES=104857600
PIWORK_RECORDINGS_MAX_USER_BYTES=1073741824
PIWORK_HUB_MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Optional tools
# ---------------------------------------------------------------------------
PIWORK_LOG_FORMAT=text
PIWORK_LOG_DIR=
PIWORK_LOG_FILE=1
PIWORK_LOG_MAX_LINES=2000000
PIWORK_ENABLE_DEFERRED_MCP_TOOL_SEARCH=false
PIWORK_ENABLE_TOOL_SEARCH=false

# Pinned Chrome extension/CDP browser bridge. Leave the directory empty to use
# the repo-local agent-browser checkout prepared by `make agent-browser`.
PIWORK_AGENT_BROWSER_ENABLED=1
PIWORK_AGENT_BROWSER_DIR=
PIWORK_AGENT_BROWSER_BRIDGE_PORT=19826

PIWORK_EDITOR_PORT=13338
PIWORK_OFFICE_PREVIEW_MAX_BYTES=83886080

# Backups are written outside data/ by default. The runtime must be stopped.
PIWORK_BACKUP_ROOT=./backups
