{
  "version": 1,
  "repository": "agentbridges-ai/pi-work",
  "defaultBranch": "main",
  "leader": "Misakago",
  "coreTeam": "piwork-core",
  "leadsTeam": "piwork-leads",
  "ordinaryApprovals": 1,
  "highRiskApprovals": 1,
  "leaderApprovals": 0,
  "leaderReviewMode": "self-or-exempt",
  "nonLeaderCoreApprovals": 2,
  "dependabotReview": {
    "enabled": true,
    "authorLogins": ["dependabot[bot]", "app/dependabot"],
    "leader": "Misakago",
    "requiredApprovals": 1,
    "dependencyPaths": [
      ".github/dependabot.yml",
      "package.json",
      "**/package.json",
      "bun.lock",
      "**/bun.lock",
      "package-lock.json",
      "**/package-lock.json",
      "pnpm-lock.yaml",
      "**/pnpm-lock.yaml",
      "yarn.lock",
      "**/yarn.lock"
    ],
    "allowedPathGlobs": [
      ".github/dependabot.yml",
      "package.json",
      "**/package.json",
      "bun.lock",
      "**/bun.lock",
      "package-lock.json",
      "**/package-lock.json",
      "pnpm-lock.yaml",
      "**/pnpm-lock.yaml",
      "yarn.lock",
      "**/yarn.lock",
      ".github/workflows/codeql.yml",
      ".github/workflows/compose-runtime.yml",
      ".github/workflows/landing-quality.yml",
      ".github/workflows/srt-linux.yml",
      ".github/workflows/verify.yml",
      "scripts/governance/dependabot-fixtures.mjs"
    ],
    "workflowActionPinPaths": [
      ".github/workflows/codeql.yml",
      ".github/workflows/compose-runtime.yml",
      ".github/workflows/landing-quality.yml",
      ".github/workflows/srt-linux.yml",
      ".github/workflows/verify.yml"
    ],
    "workflowActionPinOnly": true,
    "workflowActionPinPattern": "^\\s*uses:\\s*[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+@[0-9a-f]{40}(?:\\s+#.*)?$",
    "supportingFixturePaths": ["scripts/governance/dependabot-fixtures.mjs"],
    "supportingFixturePattern": "^\\s*\"[0-9a-f]{40}\",?\\s*$",
    "excludedWorkflowPaths": [
      ".github/workflows/deploy.yml",
      ".github/workflows/release-please.yml",
      ".github/workflows/release-evidence.yml",
      ".github/workflows/dependency-review.yml",
      ".github/workflows/governance.yml",
      ".github/workflows/deep-verify.yml",
      ".github/workflows/leader-review.yml"
    ],
    "excludedPaths": [
      "web/server/**",
      "web/shared/**",
      "web/src/**",
      "release/**",
      "release-please-config.json",
      ".release-please-manifest.json",
      "CHANGELOG.md",
      ".governance/**",
      "scripts/**",
      "Makefile"
    ],
    "excludedPathGlobs": [
      "web/server/**",
      "web/shared/**",
      "web/src/**",
      "release/**",
      "release-please-config.json",
      ".release-please-manifest.json",
      "CHANGELOG.md",
      ".governance/**",
      "scripts/**",
      "Makefile",
      ".github/workflows/deploy.yml",
      ".github/workflows/release-please.yml",
      ".github/workflows/release-evidence.yml",
      ".github/workflows/dependency-review.yml",
      ".github/workflows/governance.yml",
      ".github/workflows/deep-verify.yml",
      ".github/workflows/leader-review.yml"
    ],
    "excludedPathClasses": ["high-risk", "product", "security", "release"],
    "requireCurrentHeadLeaderApproval": true,
    "nativeLastPushApprovalRequired": true,
    "signedCommitsRequired": true,
    "requiredChecks": "requiredChecks",
    "scope": "Dependabot-only dependency manifests, lockfiles, SHA-pinned workflow actions, and their exact SHA fixture; native CODEOWNERS, last-push, signature, required-check, security, and release gates remain enforced."
  },
  "productionEnvironment": "production",
  "productionBranch": "main",
  "releaseAutomation": "github-actions",
  "workflowPermissions": {
    "default": "read",
    "canApprovePullRequestReviews": false
  },
  "requiredRepositorySecrets": ["PIWORK_RELEASE_TOKEN"],
  "securityFeatures": [
    "private-vulnerability-reporting",
    "secret-scanning",
    "secret-scanning-push-protection",
    "secret-scanning-non-provider-patterns",
    "secret-scanning-validity-checks",
    "dependabot-security-updates"
  ],
  "requiredChecks": [
    "governance",
    "quality",
    "better-auth-e2e",
    "srt-production-canaries",
    "verify",
    "landing-quality",
    "dependency-review",
    "governance-review"
  ],
  "highRiskPaths": [
    "web/server/**",
    "web/shared/**",
    "web/src/**",
    ".github/**",
    ".governance/**",
    "scripts/**",
    "Makefile",
    "release/**",
    "release-please-config.json",
    ".release-please-manifest.json",
    "CHANGELOG.md",
    "package.json",
    "**/package.json",
    "bun.lock",
    "**/bun.lock"
  ],
  "bootstrapBypassDays": 90,
  "stackedPullRequests": {
    "status": "private-preview-not-enabled",
    "dependencyOrder": ["mise", "feature", "release"],
    "conventions": {
      "baseChain": "main <- mise <- feature <- release",
      "mergeOrder": "bottom-up",
      "independentReview": "Every layer keeps its own checks, approvals, CODEOWNERS evaluation, and high-risk review.",
      "securityBoundary": "Stacked PR preview is not a bypass for CODEOWNERS, author-aware governance, last-push approval, signed commits, linear history, required checks, or production gates."
    },
    "readback": {
      "at": "2026-08-05",
      "repository": "agentbridges-ai/pi-work",
      "restEndpoint": "/repos/agentbridges-ai/pi-work/stacks",
      "restResponse": [],
      "pullRequestStackField": null,
      "officialStatus": "private preview",
      "reference": "https://github.github.com/gh-stack/reference/rest-api/"
    }
  },
  "mergeQueue": {
    "enabled": false,
    "status": "recommendation-only-not-applied",
    "availability": {
      "repositoryVisibility": "public",
      "organizationPlan": "free",
      "publicOrganizationRepositorySupport": true,
      "graphqlRepositoryMergeQueue": null,
      "restRequiredMergeQueueRule": false,
      "activeRulesets": [
        "Piwork main governance",
        "Piwork high-risk review",
        "Piwork release tags"
      ],
      "mainRulesetId": 20441671,
      "requiredStatusChecks": [
        "governance",
        "quality",
        "better-auth-e2e",
        "srt-production-canaries",
        "verify",
        "landing-quality",
        "dependency-review",
        "governance-review"
      ],
      "ghRulesetCheck": "7 rules apply to main; required_merge_queue is absent",
      "readbackAt": "2026-08-05",
      "baseCommit": "36215b770f8abb0b59d252abe2aba74950c3193d"
    },
    "deferredApply": {
      "apply": false,
      "reason": "Existing governance, mise, native-Pi, OnlyOffice, and release pull requests are not fully closed or explicitly coordinated.",
      "openPullRequests": [49, 48, 45, 17, 14, 9],
      "requiredBeforeApply": [
        "Merge or explicitly coordinate the current dependent work before changing main merge behavior.",
        "Observe the merge_group required statuses on a dedicated draft validation PR.",
        "Have an administrator apply the main ruleset merge_queue rule and read it back through REST and gh ruleset check."
      ]
    },
    "recommendedConfiguration": {
      "targetBranch": "main",
      "mergeMethod": "SQUASH",
      "mergingStrategy": "ALLGREEN",
      "maxEntriesToBuild": 1,
      "maxEntriesToMerge": 1,
      "minEntriesToMerge": 1,
      "minEntriesToMergeWaitMinutes": 5,
      "checkResponseTimeoutMinutes": 60,
      "safetyNote": "ALLGREEN requires every queued entry to pass; HEADGREEN can admit a failing entry and is not selected. The initial one-at-a-time concurrency is intentionally conservative."
    },
    "workflowContract": {
      "requiredStatusesOnMergeGroup": [
        "governance",
        "quality",
        "better-auth-e2e",
        "srt-production-canaries",
        "verify",
        "landing-quality",
        "dependency-review",
        "governance-review"
      ],
      "prMetadataNoOpStatuses": ["dependency-review", "governance-review"],
      "productionAndReleaseExcluded": ["deploy", "release-please"]
    }
  }
}
