{
  "version": 2,
  "repository": "agentbridges-ai/pi-work",
  "defaultBranch": "main",
  "maintainerTeam": "piwork-core",
  "releaseTeam": "piwork-leads",
  "ordinaryApprovals": 1,
  "highRiskApprovals": 2,
  "productionEnvironment": "production",
  "productionBranch": "main",
  "releaseAutomation": "github-actions",
  "workflowPermissions": {
    "default": "read",
    "canApprovePullRequestReviews": false
  },
  "requiredRepositorySecrets": ["PIWORK_RELEASE_TOKEN"],
  "securityFeatures": [
    "private-vulnerability-reporting",
    "secret-scanning",
    "secret-scanning-push-protection",
    "secret-scanning-non-provider-patterns",
    "secret-scanning-validity-checks",
    "dependabot-security-updates"
  ],
  "requiredChecks": [
    "governance",
    "quality",
    "better-auth-e2e",
    "srt-production-canaries",
    "verify",
    "landing-quality",
    "dependency-review"
  ],
  "highRiskPaths": [
    "web/server/**",
    "web/shared/**",
    "web/src/**",
    ".github/**",
    ".governance/**",
    "scripts/**",
    "Makefile",
    "release/**",
    "release-please-config.json",
    ".release-please-manifest.json",
    "CHANGELOG.md",
    "package.json",
    "**/package.json",
    "bun.lock",
    "**/bun.lock"
  ],
  "stackedPullRequests": {
    "enabled": false,
    "dependencyOrder": ["mise", "feature", "release"],
    "mergeOrder": "bottom-up",
    "reviewBoundary": "Each layer keeps its own checks, ownership, and review.",
    "securityBoundary": "Stacking is dependency metadata, never an approval bypass.",
    "reference": "https://github.blog/changelog/2026-07-30-stacked-pull-requests-are-now-in-public-preview/"
  },
  "mergeQueue": {
    "enabled": false,
    "applyMode": "administrator-explicit",
    "strategy": "ALLGREEN",
    "method": "SQUASH",
    "maxEntriesToBuild": 1,
    "maxEntriesToMerge": 1,
    "requiredStatusesOnMergeGroup": [
      "governance",
      "quality",
      "better-auth-e2e",
      "srt-production-canaries",
      "verify",
      "landing-quality",
      "dependency-review"
    ],
    "reference": "https://docs.github.com/en/repositories/configuring-branches-and-merges-in-your-repository/configuring-pull-request-merges/managing-a-merge-queue"
  }
}
