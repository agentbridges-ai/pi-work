{
  "version": 1,
  "repository": "agentbridges-ai/pi-work",
  "defaultBranch": "main",
  "leader": "Misakago",
  "coreTeam": "piwork-core",
  "leadsTeam": "piwork-leads",
  "ordinaryApprovals": 1,
  "highRiskApprovals": 2,
  "productionEnvironment": "production",
  "productionBranch": "main",
  "releaseAutomation": "github-actions",
  "workflowPermissions": {
    "default": "read",
    "canApprovePullRequestReviews": false
  },
  "securityFeatures": [
    "private-vulnerability-reporting",
    "secret-scanning",
    "secret-scanning-push-protection",
    "secret-scanning-non-provider-patterns",
    "secret-scanning-validity-checks",
    "dependabot-security-updates"
  ],
  "requiredChecks": [
    "governance",
    "quality",
    "better-auth-e2e",
    "srt-production-canaries",
    "verify",
    "landing-quality",
    "dependency-review",
    "governance-review"
  ],
  "highRiskPaths": [
    "web/server/*auth*",
    "web/server/*path*",
    "web/server/*secret*",
    "web/server/*credential*",
    "web/server/control-plane-*.ts",
    "web/server/rbac-*.ts",
    "web/server/tenant-*.ts",
    "web/server/database-*.ts",
    "web/server/pi-*.ts",
    "web/server/*mcp*",
    "web/server/*ws*",
    "web/server/session-*.ts",
    "web/server/migrations/**",
    "web/server/routes/*diagnostics*",
    "web/server/routes/*metrics*",
    "web/server/routes.ts",
    "web/server/routes/**",
    "web/server/routes/control-plane-*.ts",
    "web/server/onlyoffice-*.ts",
    "web/shared/**",
    "web/src/user-space-*.ts",
    "web/src/user-space-*.tsx",
    "web/src/user-space-shell/**",
    "web/src/ws*.ts",
    "web/src/api.ts",
    "web/src/*office*",
    "web/src/**/*office*",
    ".github/**",
    ".governance/**",
    "Makefile",
    "scripts/**",
    "release/**",
    "release-please-config.json",
    ".release-please-manifest.json",
    "CHANGELOG.md",
    "package.json",
    "web/package.json",
    "web/bun.lock",
    "web/eslint.config.js",
    "web/.eslint-suppressions.json",
    "landing-page/package.json",
    "landing-page/bun.lock"
  ],
  "bootstrapBypassDays": 90
}
