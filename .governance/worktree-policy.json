{
  "version": 1,
  "root": {
    "readOnly": true,
    "mustRemainClean": true,
    "resolve": "main-worktree"
  },
  "branch": {
    "prefix": "misakago/",
    "pattern": "^misakago/[a-z0-9][a-z0-9._/-]{0,80}$",
    "maxLength": 96
  },
  "paths": {
    "worktreeRoot": "../piwork-worktrees",
    "stateDir": ".git/piwork-worktree-harness",
    "policyFile": ".governance/worktree-policy.json",
    "includeFile": ".worktreeinclude"
  },
  "base": {
    "defaultRef": "origin/main",
    "requireFreshDefault": true,
    "requireExplicitBaseAncestorOfDefault": false,
    "allowPullRequestRef": true
  },
  "githubTracking": {
    "repository": "agentbridges-ai/pi-work",
    "owner": "root-coordinator",
    "executionThreadsMayModify": false,
    "writeApi": false,
    "milestones": [
      {
        "number": 1,
        "stableId": "engineering-governance-baseline-v1",
        "title": "Engineering Governance Baseline v1"
      },
      {
        "number": 2,
        "stableId": "release-0.96.0",
        "title": "Release 0.96.0"
      }
    ]
  },
  "githubRepositorySurface": {
    "readback": "github-governance-check",
    "writeAuthority": "root-coordinator-admin-only",
    "harnessRemoteWrites": false,
    "tabs": {
      "code": { "required": true, "sourceOfTruth": "repository" },
      "issues": {
        "required": true,
        "requiredMetadata": ["labels", "milestone", "tracker-issue", "issue-forms"]
      },
      "discussions": {
        "required": true,
        "requiredMetadata": ["categories", "pinned-governance-entry", "moderation-owner"]
      },
      "pullRequests": {
        "required": true,
        "requiredMetadata": [
          "template",
          "assignee",
          "reviewers",
          "labels",
          "milestone",
          "development-links",
          "required-checks"
        ],
        "mergeStrategy": "squash-only"
      },
      "agents": { "required": false, "mode": "observational" },
      "actions": {
        "required": true,
        "requiredMetadata": [
          "required-workflows",
          "merge_group",
          "read-only-default-permissions",
          "sha-pinning"
        ]
      },
      "projects": {
        "required": false,
        "mode": "optional-view-only",
        "sourceOfTruth": "github-milestone-and-tracker-issue"
      },
      "wiki": { "required": false, "mode": "no-duplicate-governance-source" },
      "securityAndQuality": {
        "required": true,
        "requiredMetadata": [
          "private-vulnerability-reporting",
          "secret-scanning",
          "dependabot",
          "codeql",
          "dependency-review"
        ]
      },
      "insights": { "required": true, "mode": "read-only" },
      "settings": { "required": true, "mode": "admin-only-readback" }
    }
  },
  "milestoneOps": {
    "sourceOfTruth": "github-milestone-and-tracker-issue",
    "requiredTrackerIssue": true,
    "requiredDependencyLinks": true,
    "dueDateRequired": true,
    "statusUpdateOnBlock": true,
    "blockedStatusEvidence": ["status-update"],
    "labelsSparse": true,
    "maxLabels": 4,
    "allowedLabels": ["governance", "feature", "release", "blocked", "needs-review"],
    "scopeChangeRequiresRootReview": true,
    "milestoneCloseRequiresRoot": true,
    "allowedStatuses": ["ready", "in-progress", "blocked", "handoff"]
  },
  "pullRequestMetadata": {
    "required": {
      "assignee": true,
      "reviewerTeams": true,
      "labels": true,
      "milestone": true,
      "developmentLink": true
    },
    "assignee": {
      "required": true,
      "defaultFrom": "owner"
    },
    "reviewerTeams": ["piwork-core", "piwork-leads"],
    "labels": {
      "minimum": 1,
      "maximum": 4,
      "source": "milestoneOps.allowedLabels"
    },
    "project": {
      "required": false,
      "mode": "optional-view-only",
      "sourceOfTruth": "github-milestone-and-tracker-issue"
    },
    "development": {
      "required": true,
      "linkTypes": ["tracker-issue", "depends-on", "stacked-pr"]
    }
  },
  "scope": {
    "highRiskPaths": [
      ".github/**",
      ".governance/**",
      "Makefile",
      "scripts/governance/**",
      "web/server/*auth*",
      "web/server/*path*",
      "web/server/*secret*",
      "web/server/*credential*",
      "web/server/pi-*.ts",
      "web/server/routes/**",
      "web/shared/**"
    ],
    "rejectAnyHighRiskOverlap": true
  },
  "lock": {
    "ttlMinutes": 240,
    "runtimeTtlSeconds": 120
  },
  "cleanup": {
    "expiredOnly": true,
    "onlyIfClean": true,
    "onlyIfNoUnpushedCommits": true,
    "retainLocalBranch": true
  },
  "coordinationModel": {
    "rootUserFacingCoordinator": true,
    "manifestIsAuthority": true,
    "milestoneOwner": "root-coordinator",
    "executionThreadsUseExclusiveWorktree": true,
    "requiredMilestoneEvidence": true,
    "requiredHandoff": true,
    "requiredHandoffEvidence": [
      "commit",
      "signature",
      "checks",
      "dirty",
      "unpushed",
      "risk",
      "nextAction"
    ],
    "parallelScopesMustBeDisjoint": true,
    "localSimulationPrecedesRemoteChecks": true,
    "finalAudit": {
      "modelSource": "runtime",
      "minimumReasoning": "ultra",
      "humanInTheLoop": true,
      "reviewBypass": false
    }
  },
  "ciOrchestration": {
    "owner": "root-coordinator",
    "riskFirst": true,
    "localPreflightRequired": true,
    "dynamicOrdering": {
      "enabled": true,
      "selection": "highest-risk-first",
      "failFast": true,
      "gatesCannotBeRemoved": true
    },
    "requiredStatuses": {
      "alwaysEmit": true,
      "unrelatedChange": "deterministic-no-op",
      "relatedChange": "real-check",
      "noSilentBypass": true
    },
    "gates": [
      {
        "id": "gate-0",
        "name": "scope-and-risk",
        "local": true,
        "failFast": true,
        "checks": ["manifest", "worktree-check", "risk-classification", "changed-files"]
      },
      {
        "id": "gate-1",
        "name": "local-fast-fail",
        "local": true,
        "failFast": true,
        "checks": ["format", "lint", "typecheck", "targeted-tests", "security-fixtures"]
      },
      {
        "id": "gate-2",
        "name": "remote-required-checks",
        "local": false,
        "failFast": true,
        "checks": ["governance", "quality", "dependency-review", "verify", "domain-canaries"]
      },
      {
        "id": "gate-3",
        "name": "combined-closeout",
        "local": false,
        "failFast": true,
        "checks": ["stacked-dependency-order", "merge-group", "release-evidence", "human-review"]
      }
    ],
    "supersededCommitCancellation": {
      "enabled": true,
      "sameScopeOnly": true,
      "neverCancelsRequiredEvidence": true
    },
    "stackedPr": {
      "enabled": true,
      "order": "dependency-order-only",
      "sequence": ["mise", "feature", "release"],
      "eachLayerChecksIndependently": true,
      "reviewBypass": false
    },
    "mergeQueue": {
      "enabledWhenAvailable": true,
      "purpose": "combined-validation-only",
      "requiredMergeGroupEvent": true,
      "reviewBypass": false
    },
    "finalAudit": {
      "modelSource": "runtime",
      "minimumReasoning": "ultra",
      "humanInTheLoop": true,
      "reviewBypass": false
    }
  },
  "milestones": [
    {
      "id": "local-simulation",
      "githubMilestone": "engineering-governance-baseline-v1",
      "title": "Local simulation",
      "owner": "root-coordinator",
      "objective": "Prove the scoped change and isolation contract locally before remote checks.",
      "entryCriteria": ["task manifest is complete", "scope is disjoint or explicitly escalated"],
      "exitCriteria": ["fixtures pass", "worktree-check passes"],
      "evidence": ["plan", "worktree-check", "fixtures"],
      "humanReviewAt": "milestone-exit",
      "blockedEscalation": "root-coordinator",
      "requiredEvidence": ["plan", "worktree-check", "fixtures"]
    },
    {
      "id": "required-checks",
      "githubMilestone": "engineering-governance-baseline-v1",
      "title": "Required checks",
      "owner": "root-coordinator",
      "objective": "Collect deterministic commit, signature, and required-check evidence.",
      "entryCriteria": ["local-simulation exit evidence is complete"],
      "exitCriteria": [
        "commit is signed",
        "required checks pass",
        "dirty and unpushed state is reported"
      ],
      "evidence": ["commit", "signature", "checks", "dirty", "unpushed"],
      "humanReviewAt": "milestone-exit",
      "blockedEscalation": "root-coordinator",
      "requiredEvidence": ["commit", "signature", "checks", "dirty", "unpushed"]
    },
    {
      "id": "handoff",
      "githubMilestone": "engineering-governance-baseline-v1",
      "title": "Root coordinator handoff",
      "owner": "root-coordinator",
      "objective": "Return a complete evidence packet and risk summary to the only user-facing coordinator.",
      "entryCriteria": ["required-checks exit evidence is complete"],
      "exitCriteria": ["handoff evidence is complete", "next action is explicit"],
      "evidence": ["commit", "checks", "signature", "risk", "handoff"],
      "humanReviewAt": "milestone-exit",
      "blockedEscalation": "root-coordinator",
      "requiredEvidence": ["commit", "checks", "signature", "risk", "handoff"]
    },
    {
      "id": "final-audit",
      "githubMilestone": "engineering-governance-baseline-v1",
      "title": "Final audit",
      "owner": "root-coordinator",
      "objective": "Complete the final model-assisted and human-in-the-loop audit before merge orchestration.",
      "entryCriteria": ["handoff evidence is complete"],
      "exitCriteria": ["human review is recorded", "merge approval is recorded"],
      "evidence": ["human-review", "merge-approval"],
      "humanReviewAt": "required-before-merge",
      "blockedEscalation": "root-coordinator",
      "requiredEvidence": ["human-review", "merge-approval"]
    }
  ],
  "roleBoundaries": {
    "rootCoordinator": {
      "userFacing": true,
      "ownsTaskDag": true,
      "ownsMerge": true
    },
    "executionThread": {
      "role": "execution-thread",
      "mayUseSubagents": true,
      "inheritsManifestScope": true,
      "mayWriteRoot": false,
      "mayWriteOtherWorktrees": false,
      "mayChangeRemotePolicy": false,
      "mayMergePullRequests": false,
      "mustHandoffTo": "root-coordinator"
    }
  },
  "workflow": {
    "order": [
      "plan",
      "claim",
      "init-in-worktree",
      "install-dependencies-in-worktree",
      "commit",
      "push",
      "pr",
      "review-merge"
    ],
    "stackedPr": "dependency-order-only",
    "mergeQueue": "combined-validation-only",
    "reviewBypass": false
  },
  "secrets": {
    "worktreeIncludeOnlyGitignoredEnv": true,
    "manifestNeverStoresContent": true,
    "sharedAcrossWorktrees": [
      ".git metadata",
      "remote refs",
      "filesystem permissions",
      "secret stores",
      "databases",
      "ports",
      "dependency caches"
    ]
  }
}
